# Copy this file to .env and fill in your Azure Speech resource details.
# Create a resource at https://portal.azure.com -> "Speech service" (any region
# with neural voices, e.g. centralindia or southeastasia works well for mr-IN).

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Origin allowed to call this proxy (the Vite dev server by default).
CLIENT_ORIGIN=http://localhost:5173

# Port this proxy listens on.
PORT=8787

# Optional: override the default neural voice per language.
# Browse voice options at https://speech.microsoft.com/portal/voicegallery
AZURE_SPEECH_VOICE_MR=mr-IN-AarohiNeural
AZURE_SPEECH_VOICE_HI=hi-IN-SwaraNeural
AZURE_SPEECH_VOICE_EN=en-IN-NeerjaNeural
